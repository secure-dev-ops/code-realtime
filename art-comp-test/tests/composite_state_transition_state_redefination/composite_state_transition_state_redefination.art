protocol MyProto {
    in ev1();
    in ev2();
    in send_msg();
};

capsule Tester {
    service behavior port p~ : MyProto;
    statemachine {
        state State;
        initial -> State
        `
            p.ev1().send();
            p.ev2().send();
        `;
    };
};

capsule LT_S_S {
    service behavior port p : MyProto;
    statemachine {
        state State1;
        state Wait_For_Messages {
            entrypoint entryPoint_0;
            state Disabled_SS {
                entrypoint entryPoint_0_1;
                exitpoint exitPoint_0;
                entrypoint entryPoint_0;
                t1: on p.ev2;
                entry
                `
                    std::cout << "entry: Disabled_SS\n";
                `;
            };
            state Enabled_SS {
                entrypoint entryPoint_0;
                exitpoint exitPoint_0;
                t2: on p.ev1;
                entry
                `
                    std::cout << "entry: Enabled_SS\n";
                `;
                exit
                `
                    std::cout << "exit: Enabled_SS\n";
                `;
            };
            Enable: Disabled_SS.exitPoint_0 -> Enabled_SS.entryPoint_0 on p.ev1 when 
            `
                std::cout << "Guard: Disabled_SS.exitPoint_0 -> Enabled_SS.entryPoint_0\n";
                return true;
            `
            `
                std::cout << "Effect: Disabled_SS.exitPoint_0 -> Enabled_SS.entryPoint_0\n";
            `;
            disable_SS: Enabled_SS.exitPoint_0 -> Disabled_SS.entryPoint_0_1 on p.ev2 when 
            `
                std::cout << "Guard: Enabled_SS.exitPoint_0 -> Disabled_SS.entryPoint_0_1\n";
                return true;
            `
            `
                std::cout << "Effect: Enabled_SS.exitPoint_0 -> Disabled_SS.entryPoint_0_1\n";
            `;
            initialized_ss: entryPoint_0 -> Disabled_SS.entryPoint_0;
        };
        Initial: initial  ->  State1;
        send_messages: State1 -> Wait_For_Messages.entryPoint_0 on p.send_msg;
    };
};

capsule LT_S_N :LT_S_S {
    statemachine {
        state redefine Wait_For_Messages {
            choice c_is_initialized;
            redefine initialized_ss: entryPoint_0 -> Disabled_SS.entryPoint_0
            `
                std::cout << "Redefined initialized_ss\n";

            `;
            state redefine Disabled_SS {
                exit
                `
                    std::cout << "exit: Redefined Disabled_SS\n";
                `;
            };
            redefine Enable : Disabled_SS.exitPoint_0 -> c_is_initialized on p.ev1
            `
                std::cout << "Redefined Enable transition\n";
            `;
            False: c_is_initialized -> Enabled_SS;
            initialized: c_is_initialized -> Enabled_SS.entryPoint_0 when 
            `
                std::cout << "Guard: New transition from c_is_initialized to Enabled_SS.entryPoint_0\n";
                return true;
            `;
        };
    };
};

capsule LT_S_TLN :LT_S_N {
    statemachine {
        state redefine Wait_For_Messages {
        };
    };
};

capsule Top {
    part tester : Tester;
    part input : LT_S_TLN;
    connect tester.p with input.p;
    statemachine {
        state State;
        initial -> State;
    };
};
